{
	"name": "forevernote",
	"description": "A local, editable notes app for an Evernote export, with search inside scanned documents.",
	"private": true,
	"version": "0.0.1",
	"license": "Unlicense",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"import": "node scripts/import.ts",
		"start": "node build/index.js",
		"ocr": "node scripts/ocr.ts",
		"deploy": "bash scripts/deploy.sh",
		"provision": "bash scripts/provision.sh",
		"backup": "bash scripts/backup.sh",
		"demo": "node scripts/demo.ts"
	},
	"dependencies": {
		"htmlparser2": "^12.0.0",
		"saxes": "^6.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.6.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
