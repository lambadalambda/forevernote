# Copy to .env and adjust. All values are optional; the defaults shown are the built-ins.

# Where the SQLite database lives.
FOREVERNOTE_DB=data/forevernote.db

# An OpenAI-compatible endpoint with a vision model, used to read scans and to
# title and tag uploads. Leave unset to run without it: PDF text layers are still
# read, and everything else is stored but not transcribed.
FOREVERNOTE_LLM_URL=http://127.0.0.1:8080/v1
FOREVERNOTE_LLM_MODEL=gemma-4-E4B-it-Q4_K_M.gguf

# Server. BODY_SIZE_LIMIT must exceed your largest upload; adapter-node
# defaults it to 512 KB, which is smaller than most scans.
PORT=3000
HOST=0.0.0.0
BODY_SIZE_LIMIT=128M

# Behind a reverse proxy.
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# XFF_DEPTH=1
